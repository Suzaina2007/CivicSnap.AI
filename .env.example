# CivicSnap.AI Environment Configuration Example

# Frontend Configuration
VITE_API_URL=your_production_proxy_url_here

# Production Proxy Configuration
PROXY_PORT=your_proxy_port_here

# Make Automation Configuration
MAKE_WEBHOOK_URL=your_make_webhook_url_here

# External Service Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Email Service Configuration
EMAIL_SERVICE_KEY=your_email_service_key_here

# Application Configuration
NODE_ENV=production
